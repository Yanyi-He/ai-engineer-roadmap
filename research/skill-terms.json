{
  "version": "2026-11-23",
  "method": "Literal mentions in the scoped role text (duties, qualifications, preferred qualifications). One count per description per term. Patterns are case-insensitive regular expressions; English terms use word boundaries where a substring would over-match ordinary prose.",
  "groups": {
    "tech_stack": {"zh": "技术栈", "en": "Tech stack"},
    "role_expectations": {"zh": "岗位期望", "en": "Role expectations"}
  },
  "terms": [
    {"key": "python", "group": "tech_stack", "zh": "Python", "en": "Python", "pattern": "\\bpython\\b"},
    {"key": "typescript", "group": "tech_stack", "zh": "TypeScript / JavaScript", "en": "TypeScript / JavaScript", "pattern": "\\btypescript\\b|\\bjavascript\\b|\\bnode\\.?js\\b"},
    {"key": "java_spring", "group": "tech_stack", "zh": "Java / Spring", "en": "Java / Spring", "pattern": "\\bjava\\b(?!\\s*script)|spring\\s?(?:boot|cloud|ai)|langchain4j"},
    {"key": "go", "group": "tech_stack", "zh": "Go", "en": "Go", "pattern": "(?-i:\\bGo\\b)(?!\\s+(?:to|beyond|deep|above|live|from|through|after))|\\bgolang\\b"},
    {"key": "sql", "group": "tech_stack", "zh": "SQL / 关系数据库", "en": "SQL / relational databases", "pattern": "\\bsql\\b|postgres|mysql|relational databases?|关系型数据库"},
    {"key": "react_frontend", "group": "tech_stack", "zh": "React / 前端", "en": "React / frontend", "pattern": "\\breact\\b|next\\.?js|\\bvue\\b|front[- ]?end|前端"},
    {"key": "docker_k8s", "group": "tech_stack", "zh": "Docker / Kubernetes", "en": "Docker / Kubernetes", "pattern": "\\bdocker\\b|kubernetes|\\bk8s\\b|容器化"},
    {"key": "cloud", "group": "tech_stack", "zh": "公有云（AWS/Azure/GCP 等）", "en": "Public cloud (AWS/Azure/GCP)", "pattern": "\\baws\\b|\\bazure\\b|\\bgcp\\b|google cloud|bedrock|vertex ai|阿里云|火山引擎|云原生"},
    {"key": "vector_db", "group": "tech_stack", "zh": "向量库 / 搜索引擎", "en": "Vector DB / search engine", "pattern": "milvus|pinecone|qdrant|weaviate|chroma\\b|faiss|pgvector|elasticsearch|opensearch|vector (?:databases?|stores?|db)|向量数据库|向量库"},
    {"key": "langchain", "group": "tech_stack", "zh": "LangChain", "en": "LangChain", "pattern": "langchain(?!4j)"},
    {"key": "langgraph", "group": "tech_stack", "zh": "LangGraph", "en": "LangGraph", "pattern": "langgraph"},
    {"key": "llamaindex", "group": "tech_stack", "zh": "LlamaIndex", "en": "LlamaIndex", "pattern": "llama.?index"},
    {"key": "dify_coze", "group": "tech_stack", "zh": "Dify / Coze / FastGPT", "en": "Dify / Coze / FastGPT", "pattern": "\\bdify\\b|\\bcoze\\b|扣子|fastgpt"},
    {"key": "agent_sdks", "group": "tech_stack", "zh": "其他 Agent 框架 / SDK", "en": "Other agent frameworks / SDKs", "pattern": "agents sdk|agent sdk|autogen|crew\\s?ai|semantic kernel|\\badk\\b|pydantic\\s?ai|mastra|ai sdk|agentscope|metagpt|qwen-agent"},
    {"key": "mcp", "group": "tech_stack", "zh": "MCP", "en": "MCP", "pattern": "\\bmcp\\b|model context protocol"},
    {"key": "pytorch", "group": "tech_stack", "zh": "PyTorch / 深度学习框架", "en": "PyTorch / DL frameworks", "pattern": "pytorch|tensorflow|\\bjax\\b|深度学习框架"},
    {"key": "hf", "group": "tech_stack", "zh": "Hugging Face", "en": "Hugging Face", "pattern": "hugging\\s?face"},
    {"key": "serving", "group": "tech_stack", "zh": "推理框架（vLLM/SGLang 等）", "en": "Serving engines (vLLM, SGLang…)", "pattern": "vllm|sglang|tensorrt|\\btriton\\b|\\btgi\\b|llama\\.cpp|ollama|lmdeploy|推理框架|推理引擎"},
    {"key": "obs_tools", "group": "tech_stack", "zh": "观测/评测工具（Langfuse 等）", "en": "Observability/eval tools (Langfuse…)", "pattern": "langfuse|langsmith|arize|phoenix|opentelemetry|braintrust|ragas|promptfoo|deepeval|weights (?:&|and) biases|\\bw&b\\b|mlflow"},
    {"key": "ai_coding_tools", "group": "tech_stack", "zh": "AI 编程工具（Cursor/Claude Code 等）", "en": "AI coding tools (Cursor, Claude Code…)", "pattern": "claude code|\\bcursor\\b|copilot|codex|windsurf|ai[- ](?:assisted|powered|native) (?:coding|development|engineering)|coding (?:agents?|assistants?)|ai ?编程|代码生成"},

    {"key": "production", "group": "role_expectations", "zh": "生产上线与交付", "en": "Shipping to production", "pattern": "\\bin production\\b|production[- ](?:grade|ready|quality|systems?|environments?|deploy\\w*|traffic|services?|scale)|\\bship(?:s|ped|ping)?\\b|\\bdeploy(?:s|ed|ing|ment|ments)?\\b|上线|落地|生产环境|工程化|产品化|交付"},
    {"key": "evaluation", "group": "role_expectations", "zh": "评测与实验", "en": "Evaluation and experiments", "pattern": "\\bevals?\\b|evaluation|evaluat(?:e|es|ing) (?:the )?(?:models?|llms?|agents?|quality|outputs?|performance|responses?)|benchmark|a/b test|评测|效果评估|评估体系|评估指标|消融"},
    {"key": "latency_cost", "group": "role_expectations", "zh": "延迟、成本与性能优化", "en": "Latency, cost and performance", "pattern": "latency|throughput|token (?:cost|usage|budget|efficien)|(?:inference|compute|serving|model|llm|api|infrastructure) costs?|cost[- ](?:efficien|optimi|effective|aware)|performance (?:optimi|tuning|bottleneck)|时延|延迟|推理成本|成本优化|性能优化|吞吐"},
    {"key": "observability", "group": "role_expectations", "zh": "可观测性与监控", "en": "Observability and monitoring", "pattern": "observab|\\btracing\\b|\\btraces\\b|monitoring|langfuse|langsmith|opentelemetry|可观测|监控|链路追踪"},
    {"key": "reliability", "group": "role_expectations", "zh": "可靠性与稳定性", "en": "Reliability", "pattern": "reliab|resilien|fault[- ]toleran|high[- ]availability|\\bslos?\\b|高可用|稳定性|容错|故障恢复"},
    {"key": "security", "group": "role_expectations", "zh": "安全、权限与合规", "en": "Security, access and compliance", "pattern": "secur(?:e|ity)\\b(?! clearance)|privacy|governance|guardrails?|access control|authoriz|permissions?|compliance|安全|隐私|合规|权限|审计"},
    {"key": "customer_facing", "group": "role_expectations", "zh": "业务/客户需求对接", "en": "Customer and stakeholder work", "pattern": "customer[- ]facing|forward[- ]deployed|(?:work|partner|collaborate) (?:directly |closely )?with customers|customers?' (?:needs|problems|workflows)|stakeholders?|业务方|客户需求|需求分析|业务需求|业务场景"},
    {"key": "system_design", "group": "role_expectations", "zh": "分布式与大规模系统", "en": "Distributed and large-scale systems", "pattern": "distributed systems?|scalab|large[- ]scale|high[- ]concurrency|system design|高并发|分布式|系统设计|架构设计"},
    {"key": "rag", "group": "role_expectations", "zh": "RAG / 检索", "en": "RAG / retrieval", "pattern": "\\brag\\b|retrieval|检索增强|知识库|检索"},
    {"key": "agents", "group": "role_expectations", "zh": "Agent / 智能体", "en": "Agents", "pattern": "\\bagents?\\b|agentic|智能体"},
    {"key": "tool_calling", "group": "role_expectations", "zh": "工具调用与集成", "en": "Tool calling and integrations", "pattern": "tool[- ]?(?:call|calls|calling|use|using)|function[- ]call|工具调用|插件|工具使用"},
    {"key": "context_engineering", "group": "role_expectations", "zh": "Prompt / 上下文工程", "en": "Prompt and context engineering", "pattern": "prompt|context engineering|context windows?|上下文|提示词"},
    {"key": "memory", "group": "role_expectations", "zh": "Agent 记忆", "en": "Agent memory", "pattern": "(?:agent|long[- ]term|short[- ]term|conversation(?:al)?|persistent) memory|memory (?:systems?|management|layer)|记忆"},
    {"key": "multi_agent", "group": "role_expectations", "zh": "多 Agent 协作", "en": "Multi-agent systems", "pattern": "multi[- ]agent|多智能体|多\\s?agent|\\ba2a\\b"},
    {"key": "data_pipelines", "group": "role_expectations", "zh": "数据管道与处理", "en": "Data pipelines", "pattern": "data pipelines?|\\betl\\b|ingestion|数据处理|数据清洗|数据管道|数据链路"},
    {"key": "fine_tuning", "group": "role_expectations", "zh": "微调 / 后训练", "en": "Fine-tuning / post-training", "pattern": "fine[- ]?tun|微调|\\bsft\\b|\\blora\\b|post[- ]training|后训练"},
    {"key": "rl", "group": "role_expectations", "zh": "强化学习 / 偏好对齐", "en": "RL / preference alignment", "pattern": "reinforcement learning|强化学习|\\brlhf\\b|\\bgrpo\\b|\\bppo\\b|\\bdpo\\b|\\brl\\b"},
    {"key": "model_internals", "group": "role_expectations", "zh": "模型原理（Transformer 等）", "en": "Model internals (transformers…)", "pattern": "transformer|attention mechanism|tokeniz|注意力机制|模型原理|模型结构"},
    {"key": "multimodal_voice", "group": "role_expectations", "zh": "多模态 / 语音", "en": "Multimodal / voice", "pattern": "multimodal|multi-modal|多模态|\\bvoice\\b|speech|语音"}
  ]
}
